  "insights": [
    {
      "title": "The apparent promo-retention penalty is mostly a cohort-mix effect",
      "type": "retention",
      "detail": "Naively, first-purchase promo users repeat within 30 days at 16.7% vs 20.3% without promo (3.7 pp gap). After standardizing within acquisition month, the gap falls to 0.5 pp.",
      "implication": "Do not conclude that discounts cause poor retention from the raw comparison. Target lifecycle experiments by cohort and measure incremental lift."
    },
    {
      "title": "Retention is the bigger growth lever than checkout recovery",
      "type": "growth",
      "detail": "Payment success is already 95.7%, while only 16.7% of mature promo-acquired buyers make a second purchase within 30 days.",
      "implication": "Prioritize post-purchase habit loops, category reminders, loyalty milestones and personalized recommendations."
    },
    {
      "title": "The business is heavily repeat-led",
      "type": "revenue",
      "detail": "79.6% of successful buyers eventually purchase again, with a median of 6 successful orders per buyer across the full observation window.",
      "implication": "A loyalty program can protect long-run value, but near-term D30 activation remains the key intervention window."
    },
    {
      "title": "Mobile dominates, but source quality is effectively flat",
      "type": "acquisition",
      "detail": "Mobile contributes 90.0% of journey sessions. Successful-payment rates and AOV are nearly identical across Mobile and Web.",
      "implication": "Instrument campaign/referrer-level acquisition before making CAC allocation decisions."
    },
    {
      "title": "Referral is an instrumentation gap\u2014not a metric to fabricate",
      "type": "measurement",
      "detail": "The dataset has no referral invites, shares, invite codes, referrer IDs or referred-user linkage.",
      "implication": "Add referral event instrumentation before claiming referral conversion or viral coefficient."
    }
  ],
